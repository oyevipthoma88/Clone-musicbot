# Apex Vibes Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Telegram API (from my.telegram.org)
API_ID=
API_HASH=

# Bot token (from @BotFather)
BOT_TOKEN=

# MongoDB Atlas connection string used live by the bot.
# This is the only MongoDB variable read by runtime code.
MONGO_DB_URI=

# Pyrogram string session of assistant/userbot account
STRING_SESSION=

# Your Telegram numeric user ID (owner)
OWNER_ID=

# Alias shown in play cards — NOT your real name
OWNER_NAME=Maestro

# Private group ID for error logs (e.g. -1001234567890)
LOG_GROUP_ID=

# Optional private channel for VC in-call chat backups. Leave empty to disable.
VC_CHAT_LOG_CHANNEL_ID=

# Base64-encoded YouTube cookies.txt. Strongly recommended on cloud hosts;
# it is the authenticated fallback when YouTube challenges the dyno IP.
YT_COOKIES=
# Optional HTTP/SOCKS proxy for YouTube only. The same proxy is used by yt-dlp
# and the direct InnerTube resolver when the deployment IP is bot-checked.
# Example: http://user:pass@proxy.example:8080
YTDLP_PROXY=
# Non-YouTube audio fallback. When YouTube bot-walls the dyno IP, the same
# song is fetched from JioSaavn (320kbps) then SoundCloud. YouTube is still
# used for search + metadata. Set ALT_SOURCE=0 to disable.
ALT_SOURCE=1
ALT_SOURCE_ORDER=jiosaavn,soundcloud
# Seconds to use the fallback FIRST after a YouTube bot wall.
ALT_SOURCE_BLOCK_TTL=900
ALT_SAAVN_BITRATE=320

# Genius API token (from genius.com/api-clients)
GENIUS_API_TOKEN=

# Note: Apex Vibes has NO song-duration cap — it plays full songs, mixes, even
# long live sets, with no cutoff anywhere in the code.

# Enable autoplay by default (true/false)
AUTOPLAY=true

# Video quality for /vplay: 720p is the stable low-latency default.
# Use 1080p only on a dyno with enough CPU/uplink; 480p/360p reduce load further.
VIDEO_QUALITY=720p

# Prefer direct CDN streaming; set false to force the download fallback.
DIRECT_STREAM=true
# Required for 3GB+/long videos: never download the complete movie to /tmp.
# Set false only for a CDN known to fail two-track video playback.
DIRECT_VIDEO_STREAM=true
# Maximum duration allowed for a local full-video fallback; 0 disables it.
VIDEO_FALLBACK_MAX_SECONDS=1800

# Maximum seconds allowed for the direct CDN handoff before local fallback.
PLAY_PROBE_TIMEOUT=7
# Hard total budget from /play request to first VC stream (clamped to 8–30s).
PLAY_STARTUP_DEADLINE=20

# Keep false on Heroku/cloud: regular growing files can emit a false EOF when
# the downloader briefly loses its lead. Set true only after validating the
# runtime; completed immutable files are the reliable fallback.
EARLY_AUDIO_HANDOFF=false

# Optional YouTube Data API v3 key(s), comma-separated for rotation.
YOUTUBE_API_KEY=

# Optional lean profile: load only music handlers and skip unrelated plugins.
MUSIC_ONLY_MODE=false
# Keep false on Heroku so old playback snapshots do not resurrect at boot.
PLAYBACK_RECOVERY=false
# Secondary Mongo GridFS upload cache; Telegram file_id cache is preferred.
MONGO_GRIDFS_CACHE=false

# Your bot's username (e.g. @YourApexVibesBot)
BOT_USERNAME=

# HTTPS URL where docs/index.html is hosted (GitHub Pages / Vercel)
# Optional — no default; set your own Web-App URL if you use one.

# GitHub integration — used by /setpic and /setwelcomepic to permanently
# save the bot's start picture and group-welcome picture to this GitHub
# repository, and to restore them automatically on every startup (so they
# survive Heroku's ephemeral filesystem across restarts/redeploys).
# GITHUB_TOKEN: Personal Access Token with `repo` (read+write) scope.
#               Generate at: GitHub → Settings → Developer settings → Personal access tokens
# GITHUB_REPO:  Your repository in "username/reponame" format.
#               Example: your-user/your-repo
GITHUB_TOKEN=
GITHUB_REPO=
# Your GitHub username (owner of the repo). Example: your-user
# Used by /setpic and live-edit commits so the bot can address the
# correct account without parsing it out of GITHUB_REPO.
GITHUB_REPO_USERNAME=

# ── Source-code button ────────────────────────────────────────────────────
# Optional. The repository URL is NOT hardcoded anywhere in the code; leave
# this empty to keep the instance's source private (the button then says the
# build is private). The owner can also set it at runtime from the bot.
SOURCE_CODE_URL=

# ── Performance / memory (Heroku R14) ─────────────────────────────────────
# Safe defaults target a 512 MB dyno. Set MEMORY_LIMIT_MB when the platform
# does not expose its quota automatically; worker/download caps adapt to it.
MEMORY_LIMIT_MB=512
BOT_WORKERS=8
ASSISTANT_WORKERS=4
BOT_TRANSMISSIONS=2
ASSISTANT_TRANSMISSIONS=2
MAX_CONCURRENT_DOWNLOADS=1
YTDL_WORKERS=4
IO_WORKERS=2

# Expensive Deno/yt-dlp and popular-search warm-ups are disabled at boot by
# default. Enable only on a larger dyno if you deliberately want prewarming.
BGUTIL_STARTUP_WARMUP=false
STARTUP_WARMUPS=false

# MEM_GUARD=off to disable, otherwise RSS is trimmed above MEM_SOFT_LIMIT_MB.
MEM_SOFT_LIMIT_MB=300
MEM_CHECK_SECONDS=5

# Playback timing knobs (normally leave these at their safe defaults).
INNERTUBE_HEADSTART=0.35
FAST_RESOLVE_TIMEOUT=1.5
RESOLVE_TIMEOUT=3.5
REMOTE_CHECK_TIMEOUT=2.5
# Cloud hosts cap the first CDN sanity probe at this budget.
REMOTE_CHECK_CLOUD_BUDGET=0.9
# Max simultaneous Telegram range-body streams across all movie viewers.
TG_PROXY_CONCURRENCY=4
FFPROBE_REMOTE_TIMEOUT=4
LOCAL_PLAY_TIMEOUT=18
CONTROL_RPC_TIMEOUT=5

# Race YouTube vs JioSaavn/SoundCloud for <5s start (1=on)
ALT_RACE=1
ALT_RACE_DELAY=0
ALT_STAGGER=1.5
