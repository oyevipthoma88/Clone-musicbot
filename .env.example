API_ID=
API_HASH=
BOT_TOKEN=
STRING_SESSION=
LOG_GROUP_ID=
OWNER_ID=
OWNER_USERNAME=
UPDATE_CHANNEL=
SUPPORT_GROUP=
SUPPORT_CHANNEL=
AUTOPLAY=true
MAX_ACTIVE_CLONES=2
CLONE_MODE=false
# Private audit destination for clone create/restore/stop events.
CLONE_USERS_LOG=
# Required for restart-persistent encrypted clone records.
MONGO_DB_URI=
CLONE_ENCRYPTION_KEY=

# Optional but recommended for YouTube reliability and fast search.
# Raw Netscape cookies.txt, base64 cookies, or a private HTTPS URL.
YT_COOKIES=
YOUTUBE_API_KEY=

# Optional tuning; conservative defaults protect small dynos.
CACHE_LIMIT_MB=96
DIRECT_TIMEOUT=7
LOCAL_TIMEOUT=18
CONTROL_TIMEOUT=5
MAX_DOWNLOAD_SECONDS=240
LOG_LEVEL=INFO
