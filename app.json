{
  "name": "𝑨𝒑𝒆𝒙 𝑽𝒊𝒃𝒆𝒔 .ᐟ.ᐟ",
  "description": "Telegram YouTube music bot with voice-chat live support",
  "keywords": ["telegram", "music", "bot", "youtube", "pyrogram"],
  "logo": "https://i.imgur.com/xvFgXuG.png",
  "success_url": "/",
  "env": {
    "API_ID": {"description": "Telegram API ID from my.telegram.org", "required": true},
    "API_HASH": {"description": "Telegram API Hash from my.telegram.org", "required": true},
    "BOT_TOKEN": {"description": "Bot token from @BotFather", "required": true},
    "MONGO_DB_URI": {"description": "MongoDB Atlas URI (mongodb+srv://...)", "required": true},
    "STRING_SESSION": {"description": "Pyrogram string session of assistant/userbot account", "required": true},
    "OWNER_ID": {"description": "Your Telegram numeric user ID", "required": true},
    "OWNER_NAME": {"description": "Alias shown in music cards", "value": "Apex Vibes", "required": false},
    "LOG_GROUP_ID": {"description": "Private Telegram group ID for error logs", "required": true},
    "BOT_USERNAME": {"description": "Your bot username, for example @ApexVibesBot", "value": "@ApexVibesBot", "required": false},
    "YT_COOKIES": {"description": "Optional Netscape cookies.txt contents for YouTube playback", "required": false},
    "YOUTUBE_API_KEY": {"description": "Optional YouTube Data API key; yt-dlp remains the primary search path", "required": false},
    "AUTOPLAY": {"description": "Enable autoplay by default", "value": "true", "required": false},
    "PLAYBACK_RECOVERY": {"description": "Rejoin old voice chats after restart", "value": "false", "required": false},
    "MONGO_GRIDFS_CACHE": {"description": "Optional GridFS upload cache", "value": "false", "required": false},
    "MEM_SOFT_LIMIT_MB": {"description": "Memory watchdog soft limit", "value": "820", "required": false}
  },
  "formation": {"worker": {"quantity": 1, "size": "standard-2x"}},
  "buildpacks": [{"url": "heroku-community/apt"}, {"url": "heroku/python"}],
  "stack": "heroku-26"
}
